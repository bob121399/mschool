APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=
OPENAI_ASSESSOR_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Models used by worker agents (course creator, HR analyst, support, sales, product analyst).
OPENAI_WORKER_MODEL=
WORKER_CONCURRENCY=2
MSCHOOL_DEMO_MODE=false
# Malware scanner (clamd INSTREAM). Uploads are not processed while it is unset.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Build/version label returned by /api/health.
APP_VERSION=dev
