{
  "name": "mschool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bash scripts/start-standalone.sh",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:evals": "vitest run --project evals",
    "test:e2e": "playwright test",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "worker:dev": "tsx --conditions=react-server worker/main.ts",
    "worker:start": "tsx --conditions=react-server worker/main.ts",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "probe": "tsx scripts/capability-probe.ts",
    "bootstrap:superadmin": "tsx scripts/bootstrap-superadmin.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check:bundle": "tsx scripts/check-bundle-secrets.ts",
    "demo": "bash scripts/demo/demo.sh",
    "demo:code": "tsx scripts/demo/code.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pdf-lib": "1.17.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
